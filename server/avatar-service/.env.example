PORT=8787

# mock：无需外部 API，供联调和汇报；http-manifest：连接真正的角色生成流水线。
AVATAR_PROVIDER=mock

# AVATAR_PROVIDER=http-manifest 时填写。供应商密钥只允许放在服务器环境变量中。
AVATAR_PROVIDER_URL=https://your-avatar-pipeline.example.com
AVATAR_PROVIDER_API_KEY=replace-me

# 生产环境填写小游戏 Web 版来源；微信小游戏还需在公众平台配置合法域名。
ALLOWED_ORIGIN=http://localhost:7456
