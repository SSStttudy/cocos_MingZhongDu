    "__prefab": null,
    "regionId": "interaction-stone-base",
    "regionType": 2,
    "enabledRegion": true,
    "priority": 10,
    "handlerId": "location-info",
    "prompt": "查看蟠龙石础",
    "triggerMode": "button",
    "payload": "{\"kicker\":\"明中都宫殿建筑遗存\",\"title\":\"蟠龙石础\",\"body\":\"据遗址现场说明，明中都宫殿区已发现4件大型蟠龙石础。石础边长约2.7米、高约1.6米，中心以三条高浮雕蟠龙围成柱槽，外径约1.9米。它们既承担巨型木柱，也以龙纹和祥云标示皇家建筑等级。照片记录了石础、现场说明牌以及三下乡团队的实地考察。\",\"images\":[{\"path\":\"interactions/stone-base/fieldwork\",\"caption\":\"三下乡团队在蟠龙石础遗址开展实地考察\"},{\"path\":\"interactions/stone-base/closeup\",\"caption\":\"蟠龙石础近景，可见中央柱槽与高浮雕纹饰\"},{\"path\":\"interactions/stone-base/info-sign\",\"caption\":\"遗址现场的蟠龙石础说明牌\"}]}",
    "targetSceneId": "",
    "targetSpawnId": "",
    "overworldEntryId": "",
    "_id": "G9xHrNmqSpuSF3DlHRFung"
  },
