        {
          "id": "interaction-wumen-xumizuo",
          "type": 2,
          "typeName": "Interaction",
          "enabled": true,
          "priority": 10,
          "handlerId": "location-info",
          "prompt": "查看午门须弥座",
          "triggerMode": "button",
          "payload": "{\"kicker\":\"午门营造细节\",\"title\":\"午门须弥座雕刻\",\"body\":\"午门城台外包巨型砖石，白石须弥座以卷草、云纹等连续纹样装饰。须弥座一方面形成城台下部的结构收边，另一方面用有秩序的石刻强调宫城正门的礼制等级。查看近景时，可以沿水平方向追踪纹样怎样连续展开，再比较转角、石材接缝、表面磨损和后期修补的差异。这些细节能帮助辨认原有雕刻与今天保护处理之间的关系。三张图片从侧墙整体、局部纹饰到石材拼接逐步靠近，让宏大的午门城台重新落到可触摸、可观察的营造尺度上。\",\"images\":[{\"path\":\"interactions/wumen/passage-side\",\"caption\":\"午门侧墙、门洞与须弥座的整体关系\"},{\"path\":\"interactions/wumen/xumizuo-dragon-cloud\",\"caption\":\"须弥座石刻近景之一\"},{\"path\":\"interactions/wumen/xumizuo-lotus-scroll\",\"caption\":\"须弥座连续纹饰与石材接缝\"}]}",
          "targetSceneId": "",
